# Only needed if you add a WalletConnect-based wallet to src/wagmi.ts.
# QoreX and injected browser wallets do not use it.
VITE_WALLETCONNECT_PROJECT_ID=

# The deployed PQTimelockVault contract address (required — the app shows
# setup instructions without it).
# Devnet deployment (local devnet only): 0x32b60D0fA270a2148dBD3386123b1979b15D0814
# Testnet: deploy first (see README § Deploy), then paste the address here.
VITE_VAULT_ADDRESS=

# Optional: override the testnet chain's EVM RPC endpoint.
# Set to http://localhost:8545 to run the app against the local devnet
# (its EVM chain id is also 9800). Leave empty for the public testnet RPC.
VITE_EVM_RPC_URL=
